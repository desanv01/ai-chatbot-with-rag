# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-signed document processing job tokens (use a separate random secret in production)
DOCUMENT_JOB_SECRET=replace-with-a-long-random-secret

# Document parsing and embeddings
LLAMA_CLOUD_API_KEY=your-llama-cloud-key
VOYAGE_API_KEY=your-voyage-key

# Chat model providers
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google model policy
GOOGLE_FREE_TIER_ONLY=true
GOOGLE_DEFAULT_MODEL=gemini-3-flash-preview
GOOGLE_FALLBACK_MODEL=gemini-3-flash-preview

# Optional website search
EXA_API_KEY=
